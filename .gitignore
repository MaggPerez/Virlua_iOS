# ============================================================
#  Virlua — .gitignore
# ============================================================

# ----- Secrets (NEVER commit these) ------------------------
Secrets*.xcconfig
*.xcconfig.local

# ----- macOS ------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Xcode ------------------------------------------------
# Build output
build/
DerivedData/
*.o
*.d
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# User-specific Xcode settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode 14+ resolved packages snapshot (keep Package.resolved for apps)
# .build/               ← commented out; keep if you use local packages

# ----- Swift Package Manager --------------------------------
.build/
.swiftpm/xcode/

# ----- CocoaPods (not used here, but just in case) ----------
# Pods/
# Podfile.lock

# ----- Carthage (not used here, but just in case) -----------
# Carthage/Build/

# ----- Fastlane ---------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ----- Misc -------------------------------------------------
*.moved-aside
*.orig
